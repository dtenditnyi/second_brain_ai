# Copy to .env and fill in your own values. Never commit .env.
# Local start (start.bat) needs none of them; production (docker compose, docs/DEPLOY.md)
# needs at least SECRET_KEY and POSTGRES_PASSWORD. Defaults are shown.
# Comments must stay on their own lines (docker compose does not strip inline comments).

# --- Django -------------------------------------------------------------------
# Production refuses to start with an empty/default key. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
# True only for development (settings_local always uses True)
DEBUG=False
# Comma separated; defaults: localhost,127.0.0.1,secondbrain-core.com
ALLOWED_HOSTS=localhost,127.0.0.1,secondbrain-core.com,secondbrain-web
# Comma separated; default: https://secondbrain-core.com
CSRF_TRUSTED_ORIGINS=https://secondbrain-core.com
# Behind Cloudflare: https is forced and HSTS sent (preload is opt-in)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=False

# --- Server (docker compose) --------------------------------------------------------
TZ=Europe/Bucharest
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=300
# Where the web container listens on the host. Keep 127.0.0.1: the site is used through
# the Cloudflare tunnel (https). A LAN address (192.168.1.50:8000) opens the port, but plain
# http in the LAN only works with SECURE_SSL_REDIRECT=False and the server IP in
# ALLOWED_HOSTS — and ports published by Docker bypass ufw (B-43).
WEB_BIND=127.0.0.1:8000
# Pin the tunnel image to a tested tag, e.g. cloudflare/cloudflared:<version>
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
# Optional image tag (deploy/update.sh uses it for rollbacks)
IMAGE_TAG=latest

# --- Logs ------------------------------------------------------------------------------
# Folder for rag_engine.log / system.log (Docker: a volume); rotated by size
LOG_DIR=
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# --- Database (PostgreSQL in docker compose) ------------------------------------------------
POSTGRES_DB=second_brain
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# --- Cloudflare Tunnel (Zero Trust → Networks → Tunnels → token) --------------------
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# --- Local AI (Ollama on another PC in the home network) --------------------------
# Example: http://192.168.1.20:11434 — if that PC is off, Auto-Hybrid uses Gemini.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# --- Cloud AI (Gemini) ----------------------------------------------------------------
# Run scripts/list_gemini_models.py to see which model IDs your key can use.
GEMINI_API_KEY=your-gemini-api-key
# Everyday chat (~500 requests/day on the free tier)
GEMINI_MODEL_DEFAULT=gemini-3.5-flash-lite
# Status report + "Smart answer" toggle (~20 requests/day on the free tier)
GEMINI_MODEL_SMART=gemini-3.8-flash
# Tried in order when a model answers 429 / RESOURCE_EXHAUSTED
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemma-4-31b-it

# --- Conversation memory and approximate prompt budgets (tokens) -------------------
CHAT_HISTORY_MESSAGES=6
PROMPT_TOKEN_BUDGET_GEMMA=8000
PROMPT_TOKEN_BUDGET_GEMINI=30000
PROMPT_TOKEN_BUDGET_LOCAL=6000

# --- Tasks in the Obsidian vault (docs/TASKS_FORMAT.md) ---------------------------------
# The vault repository token (Settings page) needs "Contents: Read and write".
TASKS_NOTE_PATH=01 - Projects/🎯 Цели и планы/Задачи.md
# Seconds between automatic syncs (pages + the scheduler service)
TASKS_SYNC_INTERVAL=60
# How often a rejected push is retried (pull + re-apply the operation)
VAULT_PUSH_RETRIES=4

# --- Local SQLite copy used by settings_local (default ai_manager/audit_copy_db.sqlite3) ---
# AUDIT_SQLITE_PATH=C:\path\to\copy.sqlite3

# --- Round 4: Claude, AI agent, REST API -------------------------------------
# Claude (Anthropic API). Without a key Claude is disabled in Settings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Agent: Gemini model for tool calling (default = GEMINI_MODEL_DEFAULT, Flash Lite), limits per request.
# GEMINI_MODEL_AGENT=gemini-3.5-flash-lite
AGENT_MAX_STEPS=8
AGENT_TOKEN_BUDGET=60000
# Ollama models with tool calling (prefix match); others cannot run the agent.
# OLLAMA_TOOL_MODELS=llama3.1,llama3.2,llama3.3,qwen2.5,qwen3,mistral-nemo,mistral-small,command-r
# Optional vault note with your own rules for the agent (added to the built-in rules).
# VAULT_RULES_NOTE=00 - Maps of content/Правила хранилища.md
# Quick capture targets and REST API rate limit (requests per minute per token).
CAPTURE_INBOX_NOTE=05 - Fleeting/📥 Входящие.md
WEEKLY_ROOT=06 - Daily
API_RATE_LIMIT_PER_MINUTE=60
