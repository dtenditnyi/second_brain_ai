# Copy to .env and fill in your own values. Never commit .env.
# Everything is optional for a local start (start.bat); defaults are shown.
# Comments must stay on their own lines (docker compose does not strip inline comments).

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
# True only for development (settings_local always uses True)
DEBUG=False

# --- Local AI (Ollama); default http://localhost:11434 ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# --- Cloud AI (Gemini) ---
# Run scripts/list_gemini_models.py to see which model IDs your key can use.
GEMINI_API_KEY=your-gemini-api-key
# Everyday chat (~500 requests/day on the free tier)
GEMINI_MODEL_DEFAULT=gemini-3.5-flash-lite
# Status report + "Smart answer" toggle (~20 requests/day on the free tier)
GEMINI_MODEL_SMART=gemini-3.8-flash
# Tried in order when a model answers 429 / RESOURCE_EXHAUSTED
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemma-4-31b-it

# --- Conversation memory and approximate prompt budgets (tokens) ---
CHAT_HISTORY_MESSAGES=6
PROMPT_TOKEN_BUDGET_GEMMA=8000
PROMPT_TOKEN_BUDGET_GEMINI=30000
PROMPT_TOKEN_BUDGET_LOCAL=6000

# --- Local SQLite copy used by settings_local (default ai_manager/audit_copy_db.sqlite3) ---
# AUDIT_SQLITE_PATH=C:\path\to\copy.sqlite3

# --- Docker / production (docker-compose.yml) ---
POSTGRES_DB=second_brain
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token
